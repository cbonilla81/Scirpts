DATAMOVER_SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
DATAMOVER_COOKIE_SECURE=false
# Initial roots are seeded into the database on first startup; manage roots in the web UI afterward.
DATAMOVER_ALLOWED_ROOTS=\\FS01\Shares;\\FS02\Shares
DATAMOVER_STATE=C:\ProgramData\DataMover
DATAMOVER_BIND=127.0.0.1
DATAMOVER_PORT=8080
DATAMOVER_TZ=America/New_York
DATAMOVER_MAX_WORKERS=2

# Optional one-time first-admin setup code. If blank, one is printed at startup.
DATAMOVER_SETUP_TOKEN=

# Optional Active Directory userPrincipalName bind over LDAP StartTLS.
DATAMOVER_AD_LDAP_URL=
DATAMOVER_AD_CA_CERT=

# Optional Microsoft Entra ID multi-tenant OpenID Connect app registration.
DATAMOVER_ENTRA_CLIENT_ID=
DATAMOVER_ENTRA_CLIENT_SECRET=
DATAMOVER_ENTRA_REDIRECT_URI=
DATAMOVER_ENTRA_ALLOWED_TENANTS=
