# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
DATAMOVER_API_KEY=REPLACE_WITH_48_PLUS_CHARACTER_RANDOM_SECRET
# Restrict to known paths / rclone remotes. Semicolon-separated. Never use unrestricted '/' in production.
DATAMOVER_ALLOWED_ROOTS=/srv/migration-source;/srv/migration-dest;onprem:;azure:;s3:
DATAMOVER_TZ=America/New_York
DATAMOVER_STATE=./state
DATAMOVER_MAX_WORKERS=2
DATAMOVER_TRANSFERS=8
